# Site Configuration
NEXT_PUBLIC_SITE_URL=https://appsto.software
NEXT_PUBLIC_SITE_NAME=Appsto

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase - Products Database (My Softwares)
PRODUCT_DB_SUPABASE_URL=your_product_db_supabase_url_here
PRODUCT_DB_SUPABASE_KEY=your_product_db_supabase_key_here

# App URL (Important for emails and redirects)
NEXT_PUBLIC_APP_URL=https://appsto.software

# Paddle Configuration
NEXT_PUBLIC_PADDLE_VENDOR_ID=your_paddle_vendor_id
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=your_paddle_api_key
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret

# Email Configuration (for Nodemailer or similar)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@appsto.software

# License Token Secret (for encryption)
LICENSE_SECRET_KEY=your_very_secure_random_secret_key_here

# API Keys
API_SECRET_KEY=your_internal_api_secret_key

# Security Settings (Development Only)
# SKIP_WEBHOOK_VERIFICATION=true  # Only use in development for testing
# ALLOW_TEST_PURCHASES=true  # Only use in development for testing

# Skillnavo Subscription Integration
SKILLNAVO_SYNC_URL=https://skillnavo.com/api/internal/billing/sync
APPSTO_BILLING_SHARED_SECRET=your_high_entropy_64_char_secret_matching_skillnavo
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTHLY=pri_skillnavo_starter_monthly
NEXT_PUBLIC_PADDLE_PRICE_STARTER_ANNUAL=pri_skillnavo_starter_annual
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=pri_skillnavo_pro_monthly
NEXT_PUBLIC_PADDLE_PRICE_PRO_ANNUAL=pri_skillnavo_pro_annual

